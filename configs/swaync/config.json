{
    "positionX": "right",
    "positionY": "top",
    "layer": "overlay",
    "control-center-margin-top": 8,
    "control-center-margin-bottom": 0,
    "control-center-margin-right": 8,
    "control-center-margin-left": 0,
    "timeout": 5,
    "timeout-low": 2,
    "timeout-critical": 0,
    "fit-to-screen": false,
    "control-center-width": 380,
    "control-center-height": 620,
    "notification-window-width": 380,
    "keyboard-shortcuts": true,
    "image-visibility": "when-available",
    "transition-time": 200,
    "hide-on-clear": false,
    "hide-on-action": true,
    "widgets": [
        "title",
        "buttons-grid",
        "mpris",
        "notifications"
    ],
    "widget-config": {
        "title": {
            "text": "  Notifications",
            "clear-all-button": true,
            "button-text": "󰎟"
        },
        "buttons-grid": {
            "actions": [
                {
                    "label": "󰤨  Internet",
                    "command": "nm-connection-editor",
                    "type": "toggle"
                },
                {
                    "label": "󰂯  Bluetooth",
                    "command": "blueman-manager",
                    "type": "toggle"
                },
                {
                    "label": "󰕾  Audio",
                    "command": "pavucontrol",
                    "type": "toggle"
                },
                {
                    "label": "󰂚  Silent",
                    "command": "swaync-client -d",
                    "type": "toggle"
                }
            ]
        },
        "mpris": {
            "image-size": 96,
            "image-radius": 12
        }
    }
}
